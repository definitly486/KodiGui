diff --git a/widevine_capture.js b/widevine_capture.js
new file mode 100644
index 0000000..9f8e7d6
--- /dev/null
+++ b/widevine_capture.js
@@ -0,0 +1,21 @@
+(function() {
+    // Перехватываем generateRequest для получения PSSH (InitData)
+    const originalGenerateRequest = MediaKeySession.prototype.generateRequest;
+    MediaKeySession.prototype.generateRequest = function(initDataType, initData) {
+        if (initDataType === 'cenc' || initDataType === 'webm') {
+            const uint8array = new Uint8Array(initData);
+            let binary = '';
+            for (let i = 0; i < uint8array.byteLength; i++) {
+                binary += String.fromCharCode(uint8array[i]);
+            }
+            const psshBase64 = btoa(binary);
+            
+            // Сохраняем в localStorage, чтобы C++ мог это прочитать
+            localStorage.setItem('wv_last_pssh', psshBase64);
+            console.log('WIDEVINE_CAPTURE: PSSH saved to localStorage ->', psshBase64);
+            
+            window.dispatchEvent(new CustomEvent('wv_data_ready', { detail: { pssh: psshBase64 } }));
+        }
+        return originalGenerateRequest.call(this, initDataType, initData);
+    };
+})();